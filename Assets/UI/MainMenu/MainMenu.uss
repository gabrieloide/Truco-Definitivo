/* =========================================================
   TRUCO DEFINITIVO - MAIN MENU STYLES
   Game Aesthetic: Bold, Tactile, Minimalist & Cohesive
   ========================================================= */

/* --- ROOT CONTAINER --- */
.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: transparent;
    overflow: hidden;
    -unity-font: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rubik.ttf");
}

/* =========================================================
   DYNAMIC BACKGROUND SYSTEM (LEXISPELL / RETRO TACTILE STYLE)
   ========================================================= */
.bg-root {
    position: absolute;
    top: -50px;
    left: -50px;
    right: -50px;
    bottom: -50px;
    overflow: hidden;
}

.bg-solid-base {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #0E141D;
}

.bg-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.65;
}

.bg-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0.90;
}

.bg-vignette {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.bg-particles {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

.bg-particle {
    position: absolute;
    background-color: rgba(232, 211, 158, 0.45);
    border-radius: 50%;
}

/* --- SCREEN CONTAINERS --- */
.screen-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

/* --- MAIN MENU HERO LAYOUT (Centered Game Title Screen) --- */
.main-layout {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.main-buttons-container {
    width: 380px;
    max-width: 90%;
    align-items: stretch;
    justify-content: center;
}

/* --- TYPOGRAPHY --- */
.title-text {
    -unity-font: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    color: #E8D39E;
    font-size: 30px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 24px;
    text-shadow: 0 3px 0 #070A0F;
}

.title-main {
    -unity-font: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    -unity-text-align: middle-center;
    font-size: 52px;
    letter-spacing: 4px;
    color: #FFFFFF;
    margin-bottom: 6px;
    width: 100%;
    white-space: normal;
    text-shadow: 0 4px 0 #070A0F;
}

.main-subtitle {
    -unity-font: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    font-size: 13px;
    letter-spacing: 4px;
    color: #E8D39E;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 38px;
    padding: 6px 20px;
    border-radius: 12px;
    background-color: rgba(232, 211, 158, 0.12);
    border-width: 1px;
    border-color: rgba(232, 211, 158, 0.35);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
}

.subtitle-text {
    -unity-font: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    color: #E8D39E;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
}

.status-text {
    -unity-font: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    color: #FF7D7D;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 12px;
    margin-bottom: 12px;
    white-space: normal;
    letter-spacing: 0.5px;
}

.credits-text {
    color: #B2C4D8;
    font-size: 17px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 12px;
}

/* --- PANELS & CARDS (Tactile Game Plaque) --- */
.panel-container {
    background-color: rgba(15, 19, 27, 0.97);
    border-radius: 18px;
    padding: 38px 46px;
    width: 540px;
    max-width: 92%;
    border-top-width: 1.5px;
    border-top-color: rgba(232, 211, 158, 0.4);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.7);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.12);
    align-items: center;
}

.lobby-panel {
    width: 900px;
    max-width: 95%;
    padding: 32px 42px;
}

/* --- FLAT GAME BUTTONS WITH SOLID DROP SHADOW (POP 2.5D) --- */
.menu-btn {
    border-radius: 14px;
    height: 56px;
    min-height: 56px;
    padding: 0 24px;
    margin: 8px 0 12px 0;
    width: 100%;
    align-items: center;
    justify-content: center;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 6px;
    border-bottom-color: #111A26;
    background-color: #223348;
    transition-property: background-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.menu-btn:hover {
    background-color: #2D425C;
}

.menu-btn:active {
    translate: 0 4px;
    border-bottom-width: 2px;
}

.btn-large {
    height: 64px;
    min-height: 64px;
    margin-bottom: 16px;
    border-bottom-width: 7px;
}

.menu-btn__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 21px;
    -unity-text-align: middle-center;
    letter-spacing: 1.5px;
    color: #FFFFFF;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.55);
}

.btn-large__text {
    font-size: 24px;
    letter-spacing: 2px;
}

/* Button Color Variants */
.menu-btn--reconnect {
    background-color: #1F8B5A;
    border-bottom-color: #0E5736;
}

.menu-btn--reconnect:hover {
    background-color: #27A66C;
}

.menu-btn--reconnect .menu-btn__text {
    color: #FFFFFF;
    text-shadow: 0 2px 0 #0A3D26;
}

.menu-btn--primary {
    background-color: #D63939;
    border-bottom-color: #821919;
}

.menu-btn--primary:hover {
    background-color: #E84444;
}

.menu-btn--primary .menu-btn__text {
    color: #FFFFFF;
    text-shadow: 0 2px 0 #5E1010;
}

.menu-btn--secondary {
    background-color: #1F2E42;
    border-bottom-color: #101824;
}

.menu-btn--secondary:hover {
    background-color: #293C55;
}

.menu-btn--secondary .menu-btn__text {
    color: #E8D39E;
    text-shadow: 0 2px 0 #080D14;
}

.menu-btn--danger {
    background-color: #A82828;
    border-bottom-color: #591111;
}

.menu-btn--danger:hover {
    background-color: #BC3030;
}

.menu-btn--danger .menu-btn__text {
    color: #FFD6D6;
    text-shadow: 0 2px 0 #3D0A0A;
}

.menu-btn--back {
    background-color: #182230;
    border-bottom-color: #0C1118;
    width: 60%;
    height: 50px;
    min-height: 50px;
    border-bottom-width: 5px;
}

.menu-btn--back:hover {
    background-color: #223044;
}

.menu-btn--back:active {
    translate: 0 3px;
    border-bottom-width: 2px;
}

.menu-btn--back .menu-btn__text {
    color: #E8D39E;
    font-size: 18px;
    text-shadow: 0 2px 0 #070B10;
}

/* --- INPUTS & CONTROLS (Recessed Game Slots) --- */
.input-group {
    width: 100%;
    margin-bottom: 20px;
    align-items: stretch;
}

.input-label {
    color: #E8D39E;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
}

.menu-input {
    width: 100%;
}

.menu-input > .unity-base-text-field__input {
    background-color: rgba(8, 11, 16, 0.88);
    border-radius: 10px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-width: 2px;
    border-bottom-color: rgba(232, 211, 158, 0.35);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    padding: 13px 18px;
    font-size: 18px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1.5px;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.menu-input > .unity-base-text-field__input:focus {
    border-bottom-color: #E8D39E;
    border-color: rgba(232, 211, 158, 0.7);
}

.divider {
    height: 1px;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    margin: 22px 0;
}

/* --- SETTINGS GROUPS --- */
.settings-group {
    width: 100%;
    background-color: rgba(10, 13, 19, 0.6);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 22px;
    margin-bottom: 20px;
}

.menu-slider Label, .menu-dropdown Label, .menu-toggle Label {
    color: #BAC7D5;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    min-width: 160px;
}

.menu-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.15);
    height: 6px;
    border-radius: 3px;
    border-width: 0;
    margin-top: -3px;
}

.menu-slider .unity-base-slider__dragger {
    background-color: #E8D39E;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #FFF2CE;
    margin-top: -10px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.menu-slider .unity-base-slider__dragger:hover {
    scale: 1.25;
}

.menu-dropdown .unity-base-popup-field__input {
    background-color: rgba(8, 11, 16, 0.88);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-bottom-width: 2px;
    border-bottom-color: rgba(232, 211, 158, 0.35);
    padding: 8px 14px;
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 15px;
}

/* --- LOBBY SCREEN SPECIFICS (Team Arenas & Versus Crest) --- */
.room-code-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 24px;
    padding: 6px 18px;
    background-color: rgba(8, 11, 16, 0.6);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(232, 211, 158, 0.2);
}

.room-code-label {
    margin-bottom: 0;
    font-size: 20px;
    letter-spacing: 3px;
    color: #E8D39E;
    -unity-font-style: bold;
}

.menu-btn--copy {
    width: auto;
    height: 38px;
    min-height: 38px;
    margin: 0 0 0 14px;
    padding: 0 18px;
    border-radius: 8px;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: #8C5F11;
    background-color: #E5A93C;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.menu-btn--copy:hover {
    background-color: #F2B545;
}

.menu-btn--copy:active {
    translate: 0 2px;
    border-bottom-width: 2px;
}

.menu-btn--copy__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 14px;
    color: #261603;
    letter-spacing: 1.5px;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.3);
}

.lobby-teams-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    width: 100%;
    margin-bottom: 24px;
}

.lobby-team-card {
    flex-grow: 1;
    align-items: stretch;
    background-color: rgba(12, 16, 23, 0.85);
    border-radius: 14px;
    border-top-width: 3.5px;
    border-top-color: #C23535;
    border-bottom-width: 4px;
    border-bottom-color: rgba(0, 0, 0, 0.6);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    padding: 20px;
    margin: 0 10px;
    width: 44%;
}

.lobby-team-card--team2 {
    border-top-color: #1E66B8;
}

.vs-badge {
    justify-content: center;
    align-items: center;
    width: 68px;
}

.vs-text {
    -unity-font: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    color: #E8D39E;
    font-size: 26px;
    letter-spacing: 2px;
    text-shadow: 0 2px 0 #0A0F17;
    margin-bottom: 14px;
}

.swap-btn {
    width: 46px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    margin: 0 0 10px 0;
    display: none;
    border-radius: 8px;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: #121B27;
    background-color: #24354A;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.swap-btn:hover {
    background-color: #2F445E;
}

.swap-btn:active {
    translate: 0 2px;
    border-bottom-width: 2px;
}

.swap-btn__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 20px;
    letter-spacing: 0;
    color: #E8D39E;
}

.player-slot {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 10px;
    min-height: 48px;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.player-name {
    color: #E2E8F0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.row-buttons {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 20px;
}

.row-buttons > .menu-btn {
    width: 31%;
    margin: 0;
    height: 52px;
    min-height: 52px;
}

.row-buttons > .menu-btn > .menu-btn__text {
    font-size: 16px;
    letter-spacing: 1.5px;
}

/* Team Name Input */
.team-name-input {
    margin-bottom: 18px;
    width: 100%;
}

.team-name-input > .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(232, 211, 158, 0.45);
    border-radius: 0;
    padding: 0 0 8px 0;
    font-size: 20px;
    color: #E8D39E;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.team-name-input:focus > .unity-base-text-field__input {
    border-color: #E8D39E;
}

.team-name-input.unity-disabled,
.team-name-input:disabled {
    opacity: 0.8;
}

/* =========================================================
   TOP PROFILE BAR & CLOUD STATUS
   ========================================================= */
.profile-bar {
    position: absolute;
    top: 24px;
    left: 32px;
    right: 32px;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
}

.profile-info-group {
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 20, 29, 0.92);
    padding: 8px 18px;
    margin: 0;
    border-radius: 16px;
    border-top-width: 1px;
    border-top-color: rgba(232, 211, 158, 0.35);
    border-bottom-width: 4px;
    border-bottom-color: rgba(0, 0, 0, 0.7);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    transition-property: background-color;
    transition-duration: 0.12s;
}

.profile-info-group:hover {
    background-color: #1A2636;
    border-top-color: rgba(232, 211, 158, 0.7);
}

.profile-info-group:active {
    translate: 0 2px;
    border-bottom-width: 2px;
}

.profile-avatar {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: #1F2E42;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    border-width: 2px;
    border-color: #E8D39E;
}

.profile-avatar__icon {
    font-size: 22px;
    color: #E8D39E;
    -unity-text-align: middle-center;
}

.profile-text-group {
    flex-direction: column;
}

.profile-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.profile-name {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 19px;
    color: #FFFFFF;
    letter-spacing: 1px;
    margin-right: 10px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.profile-status-badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 7px;
    border-radius: 6px;
    letter-spacing: 1px;
}

.profile-status--guest {
    background-color: rgba(232, 211, 158, 0.16);
    color: #E8D39E;
    border-width: 1px;
    border-color: rgba(232, 211, 158, 0.4);
}

.profile-status--cloud {
    background-color: rgba(46, 204, 113, 0.2);
    color: #2ECC71;
    border-width: 1px;
    border-color: rgba(46, 204, 113, 0.5);
}

.profile-stats-row {
    flex-direction: row;
    align-items: center;
}

.profile-stat-badge {
    background-color: #1A2535;
    color: #E8D39E;
    font-size: 11px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 6px;
    margin-right: 10px;
    border-width: 1px;
    border-color: rgba(232, 211, 158, 0.25);
}

.profile-stat-coins {
    color: #FFDE59;
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 12px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

.profile-stat-sub {
    color: #A0B2C6;
    font-size: 12px;
    letter-spacing: 0.5px;
}



/* =========================================================
   AUTH MODAL & TABS
   ========================================================= */
.auth-panel {
    width: 480px;
    max-width: 92%;
    padding: 34px 40px;
}

.auth-subtitle {
    font-size: 13px;
    color: #BAC7D5;
    -unity-text-align: middle-center;
    margin-bottom: 22px;
    white-space: normal;
    letter-spacing: 0.5px;
}

.auth-tabs {
    flex-direction: row;
    width: 100%;
    margin-bottom: 20px;
}

.auth-tab-btn {
    flex-grow: 1;
    height: 44px;
    border-radius: 10px;
    background-color: #151D28;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    align-items: center;
    justify-content: center;
    margin: 0 4px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.auth-tab-btn:hover {
    background-color: #1F2B3B;
}

.auth-tab-btn--active {
    background-color: #D63939;
    border-width: 1px;
    border-color: #E84444;
}

.auth-tab-btn__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 16px;
    color: #FFFFFF;
    letter-spacing: 1px;
}

/* =========================================================
   PROFILE DETAILS VIEW (WHEN LOGGED IN)
   ========================================================= */
.profile-panel {
    width: 520px;
    max-width: 94%;
    padding: 32px 38px;
}

.profile-card-header {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
    padding: 14px 18px;
    background-color: rgba(10, 15, 22, 0.75);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(232, 211, 158, 0.2);
}

.profile-avatar--large {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    background-color: #1F2E42;
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    border-width: 2px;
    border-color: #E8D39E;
}

.profile-avatar__icon--large {
    font-size: 28px;
    color: #E8D39E;
    -unity-text-align: middle-center;
}

.profile-card-details {
    flex-direction: column;
    flex-grow: 1;
}

.profile-card-username {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 22px;
    color: #FFFFFF;
    letter-spacing: 1px;
}

.profile-card-email {
    font-size: 13px;
    color: #BAC7D5;
    margin-bottom: 4px;
}

/* 2-Column Stats Grid */
.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 20px;
}

.stat-box {
    width: 48%;
    background-color: rgba(14, 20, 29, 0.85);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 12px;
    border-top-width: 1px;
    border-top-color: rgba(232, 211, 158, 0.2);
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0.6);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
}

.stat-box__title {
    font-size: 11px;
    color: #BAC7D5;
    letter-spacing: 1px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.stat-box__value {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 18px;
    color: #E8D39E;
    letter-spacing: 1px;
}

.stat-box__value--gold {
    color: #FFDE59;
}

.stat-box__value--green {
    color: #5CE696;
}

/* =========================================================
   MULTIPLAYER READ-ONLY PLAYER CARD
   ========================================================= */
.multiplayer-player-card {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 22px;
    padding: 12px 18px;
    background-color: rgba(10, 15, 22, 0.85);
    border-radius: 14px;
    border-top-width: 1px;
    border-top-color: rgba(232, 211, 158, 0.3);
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0.6);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
}

.multiplayer-name-text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 20px;
    color: #FFFFFF;
    letter-spacing: 1px;
}

.version-label {
    position: absolute;
    bottom: 10px;
    right: 16px;
    font-size: 13px;
    color: rgba(232, 211, 158, 0.6);
    -unity-font-style: bold;
    letter-spacing: 1.2px;
}



