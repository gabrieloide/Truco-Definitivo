/* =========================================================
   TRUCO DEFINITIVO - MAIN MENU STYLES
   Game Aesthetic: Bold, Tactile, Minimalist & Cohesive
   ========================================================= */

/* --- ROOT CONTAINER --- */
.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 13, 18, 0.94);
}

/* --- SCREEN CONTAINERS --- */
.screen-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

/* --- MAIN MENU HERO LAYOUT (Centered Game Title Screen) --- */
.main-layout {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px;
}

.main-buttons-container {
    width: 380px;
    max-width: 90%;
    align-items: stretch;
    justify-content: center;
}

/* --- TYPOGRAPHY --- */
.title-text {
    color: #E8D39E;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    margin-bottom: 24px;
    text-shadow: 0 3px 12px rgba(0, 0, 0, 0.9);
}

.title-main {
    -unity-text-align: middle-center;
    font-size: 58px;
    letter-spacing: 6px;
    color: #FFFFFF;
    margin-bottom: 6px;
    width: 100%;
    white-space: normal;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.95);
}

.main-subtitle {
    font-size: 13px;
    letter-spacing: 5px;
    color: #E8D39E;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 38px;
    padding: 5px 20px;
    border-radius: 12px;
    background-color: rgba(232, 211, 158, 0.1);
    border-width: 1px;
    border-color: rgba(232, 211, 158, 0.3);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.subtitle-text {
    color: #E8D39E;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

.status-text {
    color: #FF7D7D;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 12px;
    margin-bottom: 12px;
    white-space: normal;
    letter-spacing: 0.5px;
}

.credits-text {
    color: #B2C4D8;
    font-size: 17px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 12px;
}

/* --- PANELS & CARDS (Tactile Game Plaque) --- */
.panel-container {
    background-color: rgba(15, 19, 27, 0.97);
    border-radius: 18px;
    padding: 38px 46px;
    width: 540px;
    max-width: 92%;
    border-top-width: 1.5px;
    border-top-color: rgba(232, 211, 158, 0.4);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.7);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.12);
    align-items: center;
}

.lobby-panel {
    width: 900px;
    max-width: 95%;
    padding: 32px 42px;
}

/* --- GAME BUTTONS (Tactile 3D Bevel & Solid Weight) --- */
.menu-btn {
    border-radius: 12px;
    height: 56px;
    min-height: 56px;
    padding: 0 24px;
    margin: 8px 0;
    width: 100%;
    align-items: center;
    justify-content: center;
    border-top-width: 1.5px;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.65);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(28, 36, 48, 0.95);
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.menu-btn:hover {
    scale: 1.02;
    translate: 0 -2px;
    background-color: rgba(38, 48, 64, 0.98);
    border-top-color: rgba(255, 255, 255, 0.6);
}

.menu-btn:active {
    scale: 0.98;
    translate: 0 4px;
    border-bottom-width: 1.5px;
}

.btn-large {
    height: 64px;
    min-height: 64px;
    margin-bottom: 14px;
}

.menu-btn__text {
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    color: #F0F4F8;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
}

.btn-large__text {
    font-size: 22px;
    letter-spacing: 2.5px;
}

/* Button Color Variants */
.menu-btn--primary {
    background-color: #A92D2D;
    border-top-color: rgba(255, 170, 170, 0.6);
    border-bottom-color: #4A0E0E;
}

.menu-btn--primary:hover {
    background-color: #C23535;
    border-top-color: rgba(255, 210, 210, 0.8);
}

.menu-btn--primary .menu-btn__text {
    color: #FFFFFF;
}

.menu-btn--secondary {
    background-color: rgba(32, 41, 55, 0.95);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(12, 16, 22, 0.8);
}

.menu-btn--secondary:hover {
    background-color: rgba(44, 56, 75, 0.98);
    border-top-color: rgba(232, 211, 158, 0.7);
    border-color: rgba(232, 211, 158, 0.4);
}

.menu-btn--danger {
    background-color: rgba(90, 24, 24, 0.85);
    border-top-color: rgba(255, 120, 120, 0.35);
    border-bottom-color: rgba(35, 8, 8, 0.9);
}

.menu-btn--danger:hover {
    background-color: rgba(120, 32, 32, 0.95);
    border-top-color: rgba(255, 160, 160, 0.6);
}

.menu-btn--danger .menu-btn__text {
    color: #FFAAA0;
}

.menu-btn--back {
    background-color: rgba(24, 30, 42, 0.85);
    border-top-color: rgba(232, 211, 158, 0.35);
    border-bottom-color: rgba(10, 14, 20, 0.8);
    width: 60%;
    height: 50px;
    min-height: 50px;
}

.menu-btn--back:hover {
    background-color: rgba(35, 45, 62, 0.95);
    border-color: #E8D39E;
}

.menu-btn--back .menu-btn__text {
    color: #E8D39E;
    font-size: 17px;
}

/* --- INPUTS & CONTROLS (Recessed Game Slots) --- */
.input-group {
    width: 100%;
    margin-bottom: 20px;
    align-items: stretch;
}

.input-label {
    color: #E8D39E;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
}

.menu-input {
    width: 100%;
}

.menu-input > .unity-base-text-field__input {
    background-color: rgba(8, 11, 16, 0.88);
    border-radius: 10px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.6);
    border-bottom-width: 2px;
    border-bottom-color: rgba(232, 211, 158, 0.35);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    padding: 13px 18px;
    font-size: 18px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1.5px;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.menu-input > .unity-base-text-field__input:focus {
    border-bottom-color: #E8D39E;
    border-color: rgba(232, 211, 158, 0.7);
}

.divider {
    height: 1px;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    margin: 22px 0;
}

/* --- SETTINGS GROUPS --- */
.settings-group {
    width: 100%;
    background-color: rgba(10, 13, 19, 0.6);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 22px;
    margin-bottom: 20px;
}

.menu-slider Label, .menu-dropdown Label, .menu-toggle Label {
    color: #BAC7D5;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    min-width: 160px;
}

.menu-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.15);
    height: 6px;
    border-radius: 3px;
    border-width: 0;
    margin-top: -3px;
}

.menu-slider .unity-base-slider__dragger {
    background-color: #E8D39E;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #FFF2CE;
    margin-top: -10px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.menu-slider .unity-base-slider__dragger:hover {
    scale: 1.25;
}

.menu-dropdown .unity-base-popup-field__input {
    background-color: rgba(8, 11, 16, 0.88);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-bottom-width: 2px;
    border-bottom-color: rgba(232, 211, 158, 0.35);
    padding: 8px 14px;
    color: #FFFFFF;
    -unity-font-style: bold;
    font-size: 15px;
}

/* --- LOBBY SCREEN SPECIFICS (Team Arenas & Versus Crest) --- */
.room-code-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 24px;
    padding: 6px 18px;
    background-color: rgba(8, 11, 16, 0.6);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(232, 211, 158, 0.2);
}

.room-code-label {
    margin-bottom: 0;
    font-size: 20px;
    letter-spacing: 3px;
    color: #E8D39E;
    -unity-font-style: bold;
}

.menu-btn--copy {
    width: auto;
    height: 38px;
    min-height: 38px;
    margin: 0 0 0 14px;
    padding: 0 16px;
    border-radius: 8px;
    border-bottom-width: 3px;
    background-color: rgba(232, 211, 158, 0.18);
    border-color: rgba(232, 211, 158, 0.35);
}

.menu-btn--copy:hover {
    background-color: rgba(232, 211, 158, 0.3);
    border-color: #E8D39E;
}

.menu-btn--copy__text {
    font-size: 13px;
    color: #FFF0C4;
    letter-spacing: 1.5px;
}

.lobby-teams-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    width: 100%;
    margin-bottom: 24px;
}

.lobby-team-card {
    flex-grow: 1;
    align-items: stretch;
    background-color: rgba(12, 16, 23, 0.85);
    border-radius: 14px;
    border-top-width: 3.5px;
    border-top-color: #C23535;
    border-bottom-width: 4px;
    border-bottom-color: rgba(0, 0, 0, 0.6);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    padding: 20px;
    margin: 0 10px;
    width: 44%;
}

.lobby-team-card:last-child {
    border-top-color: #1E66B8;
}

.vs-badge {
    justify-content: center;
    align-items: center;
    width: 68px;
}

.vs-text {
    color: #E8D39E;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    margin-bottom: 14px;
}

.swap-btn {
    width: 46px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    margin: 0 0 10px 0;
    display: none;
    border-radius: 8px;
    border-bottom-width: 3px;
    background-color: rgba(30, 38, 52, 0.9);
    border-color: rgba(255, 255, 255, 0.15);
}

.swap-btn__text {
    font-size: 20px;
    letter-spacing: 0;
    color: #E8D39E;
}

.player-slot {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 10px;
    min-height: 48px;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
}

.player-name {
    color: #E2E8F0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.row-buttons {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 20px;
}

.row-buttons > .menu-btn {
    width: 31%;
    margin: 0;
    height: 52px;
    min-height: 52px;
}

.row-buttons > .menu-btn > .menu-btn__text {
    font-size: 16px;
    letter-spacing: 1.5px;
}

/* Team Name Input */
.team-name-input {
    margin-bottom: 18px;
    width: 100%;
}

.team-name-input > .unity-base-text-field__input {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(232, 211, 158, 0.45);
    border-radius: 0;
    padding: 0 0 8px 0;
    font-size: 20px;
    color: #E8D39E;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.team-name-input:focus > .unity-base-text-field__input {
    border-color: #E8D39E;
}

.team-name-input.unity-disabled,
.team-name-input:disabled {
    opacity: 0.8;
}
