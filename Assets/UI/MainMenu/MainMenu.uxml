<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=c190ae18013617e4fb0afc94f6f9bc70&amp;type=3#MainMenu"/>
    <engine:VisualElement class="menu-root">
        <engine:VisualElement name="bg-root" picking-mode="Ignore" class="bg-root">
            <engine:VisualElement name="bg-solid-base" picking-mode="Ignore" class="bg-solid-base"/>
            <engine:VisualElement name="bg-glow" picking-mode="Ignore" class="bg-glow"/>
            <engine:VisualElement name="bg-pattern" picking-mode="Ignore" class="bg-pattern"/>
            <engine:VisualElement name="bg-vignette" picking-mode="Ignore" class="bg-vignette"/>
            <engine:VisualElement name="bg-particles" picking-mode="Ignore" class="bg-particles"/>
        </engine:VisualElement>
        <engine:VisualElement name="screen-main" class="screen-container main-layout">
            <engine:VisualElement name="top-profile-bar" class="profile-bar">
                <engine:Button name="btn-profile-info" class="profile-info-group">
                    <engine:VisualElement class="profile-avatar">
                        <engine:Label text="🂡" class="profile-avatar__icon"/>
                    </engine:VisualElement>
                    <engine:VisualElement class="profile-text-group">
                        <engine:VisualElement class="profile-name-row">
                            <engine:Label name="lbl-profile-name" text="Gaucho" class="profile-name"/>
                            <engine:Label name="lbl-profile-status" text="INVITADO" class="profile-status-badge profile-status--guest"/>
                        </engine:VisualElement>
                        <engine:VisualElement class="profile-stats-row">
                            <engine:Label name="lbl-profile-level" text="NV. 1" class="profile-stat-badge"/>
                            <engine:Label name="lbl-profile-coins" text="🪙 1.000" class="profile-stat-coins"/>
                            <engine:Label name="lbl-profile-winrate" text="V: 0 | D: 0" class="profile-stat-sub"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:Button>
            </engine:VisualElement>
            <engine:Label text="TRUCO DEFINITIVO" class="title-text title-main"/>
            <engine:VisualElement class="main-buttons-container">
                <engine:Button name="btn-main-reconnect" class="menu-btn menu-btn--reconnect btn-large" style="display: none;">
                    <engine:Label text="🔄 RECONECTARSE A SALA" class="menu-btn__text btn-large__text"/>
                </engine:Button>
                <engine:Button name="btn-main-singleplayer" class="menu-btn menu-btn--primary btn-large">
                    <engine:Label text="UN JUGADOR" class="menu-btn__text btn-large__text"/>
                </engine:Button>
                <engine:Button name="btn-main-play" class="menu-btn menu-btn--secondary">
                    <engine:Label text="MULTIJUGADOR" class="menu-btn__text"/>
                </engine:Button>
                <engine:Button name="btn-main-settings" class="menu-btn menu-btn--secondary">
                    <engine:Label text="OPCIONES" class="menu-btn__text"/>
                </engine:Button>
                <engine:Button name="btn-main-credits" class="menu-btn menu-btn--secondary">
                    <engine:Label text="CRÉDITOS" class="menu-btn__text"/>
                </engine:Button>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="screen-singleplayer-setup" class="screen-container" style="display: none;">
            <engine:VisualElement class="panel-container">
                <engine:Label text="MODO UN JUGADOR" class="title-text"/>
                <engine:VisualElement class="settings-group" style="margin-bottom: 40px;">
                    <engine:Label text="Configura tu partida:" class="input-label" style="-unity-font-style: bold; margin-bottom: 10px;"/>
                    <engine:DropdownField name="dropdown-single-points" label="Puntos de Victoria:" choices="12,24" index="0" class="menu-dropdown"/>
                </engine:VisualElement>
                <engine:Button name="btn-single-start" class="menu-btn menu-btn--primary">
                    <engine:Label text="EMPEZAR PARTIDA" class="menu-btn__text"/>
                </engine:Button>
                <engine:Button name="btn-single-back" class="menu-btn menu-btn--back" style="margin-top: 20px;">
                    <engine:Label text="VOLVER" class="menu-btn__text"/>
                </engine:Button>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="screen-play" class="screen-container" style="display: none;">
            <engine:VisualElement class="panel-container">
                <engine:Label text="MULTIJUGADOR" class="title-text"/>
                <engine:Label name="lbl-play-status" text="" class="status-text" style="display: none;"/>
                <engine:VisualElement name="group-multiplayer-guest" class="input-group">
                    <engine:Label text="Tu Nombre / Apodo (Invitado):" class="input-label"/>
                    <engine:TextField name="input-nickname" max-length="16" class="menu-input"/>
                </engine:VisualElement>
                <engine:VisualElement name="group-multiplayer-logged" class="multiplayer-player-card" style="display: none;">
                    <engine:VisualElement class="profile-avatar" style="width: 38px; height: 38px; min-width: 38px; margin-right: 12px;">
                        <engine:Label text="🂡" class="profile-avatar__icon" style="font-size: 18px;"/>
                    </engine:VisualElement>
                    <engine:VisualElement style="flex-direction: column; flex-grow: 1;">
                        <engine:Label text="JUGANDO COMO (CUENTA VINCULADA):" class="input-label" style="margin-bottom: 2px; font-size: 11px;"/>
                        <engine:Label name="lbl-multiplayer-name" text="Gaucho" class="multiplayer-name-text"/>
                    </engine:VisualElement>
                    <engine:Label text="NUBE" class="profile-status-badge profile-status--cloud" style="align-self: center; margin-left: 8px;"/>
                </engine:VisualElement>
                <engine:Button name="btn-play-host" class="menu-btn menu-btn--primary">
                    <engine:Label text="CREAR SALA" class="menu-btn__text"/>
                </engine:Button>
                <engine:VisualElement class="divider"/>
                <engine:VisualElement class="input-group">
                    <engine:Label text="Código de Sala:" class="input-label"/>
                    <engine:TextField name="input-room-code" class="menu-input"/>
                </engine:VisualElement>
                <engine:Button name="btn-play-join" class="menu-btn menu-btn--secondary">
                    <engine:Label text="UNIRSE CON CÓDIGO" class="menu-btn__text"/>
                </engine:Button>
                <engine:Button name="btn-play-back" class="menu-btn menu-btn--back" style="margin-top: 30px;">
                    <engine:Label text="VOLVER" class="menu-btn__text"/>
                </engine:Button>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="screen-lobby" class="screen-container" style="display: none;">
            <engine:VisualElement class="panel-container lobby-panel">
                <engine:Label text="SALA DE ESPERA" class="title-text"/>
                <engine:VisualElement class="room-code-row">
                    <engine:Label name="lbl-room-code" text="CÓDIGO: ----" class="subtitle-text room-code-label"/>
                    <engine:Button name="btn-copy-code" class="menu-btn menu-btn--secondary menu-btn--copy">
                        <engine:Label text="COPIAR" class="menu-btn__text menu-btn--copy__text"/>
                    </engine:Button>
                </engine:VisualElement>
                <engine:VisualElement class="lobby-teams-container">
                    <engine:VisualElement class="lobby-team lobby-team-card">
                        <engine:TextField name="input-team1-name" value="EQUIPO 1" max-length="16" class="team-name-input"/>
                        <engine:VisualElement class="player-slot">
                            <engine:Label name="lbl-t1-p1" text="Esperando..." class="player-name"/>
                        </engine:VisualElement>
                        <engine:VisualElement class="player-slot">
                            <engine:Label name="lbl-t1-p2" text="Esperando..." class="player-name"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement class="vs-badge">
                        <engine:Label text="VS" class="vs-text"/>
                        <engine:Button name="btn-lobby-swap-1" class="menu-btn menu-btn--secondary swap-btn">
                            <engine:Label text="↔" class="menu-btn__text swap-btn__text"/>
                        </engine:Button>
                        <engine:Button name="btn-lobby-swap-2" class="menu-btn menu-btn--secondary swap-btn">
                            <engine:Label text="↔" class="menu-btn__text swap-btn__text"/>
                        </engine:Button>
                    </engine:VisualElement>
                    <engine:VisualElement class="lobby-team lobby-team-card lobby-team-card--team2">
                        <engine:TextField name="input-team2-name" value="EQUIPO 2" max-length="16" class="team-name-input"/>
                        <engine:VisualElement class="player-slot">
                            <engine:Label name="lbl-t2-p1" text="Esperando..." class="player-name"/>
                        </engine:VisualElement>
                        <engine:VisualElement class="player-slot">
                            <engine:Label name="lbl-t2-p2" text="Esperando..." class="player-name"/>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement class="settings-group">
                    <engine:DropdownField name="dropdown-points" label="Puntos de Victoria:" choices="12,24" index="0" class="menu-dropdown"/>
                </engine:VisualElement>
                <engine:Label name="lbl-lobby-status" text="" class="status-text" style="display: none;"/>
                <engine:VisualElement class="row-buttons">
                    <engine:Button name="btn-lobby-back" class="menu-btn menu-btn--danger">
                        <engine:Label text="SALIR" class="menu-btn__text"/>
                    </engine:Button>
                    <engine:Button name="btn-lobby-ready" class="menu-btn menu-btn--secondary">
                        <engine:Label text="LISTO" class="menu-btn__text"/>
                    </engine:Button>
                    <engine:Button name="btn-lobby-start" class="menu-btn menu-btn--primary">
                        <engine:Label text="EMPEZAR" class="menu-btn__text"/>
                    </engine:Button>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="screen-settings" class="screen-container" style="display: none;">
            <engine:VisualElement class="panel-container">
                <engine:Label text="OPCIONES" class="title-text"/>
                <engine:VisualElement class="settings-group">
                    <engine:Slider name="slider-master" label="Volumen General" low-value="0" high-value="100" value="100" class="menu-slider"/>
                    <engine:Slider name="slider-music" label="Música" low-value="0" high-value="100" value="100" class="menu-slider"/>
                    <engine:Slider name="slider-sfx" label="Efectos" low-value="0" high-value="100" value="100" class="menu-slider"/>
                </engine:VisualElement>
                <engine:VisualElement class="settings-group">
                    <engine:DropdownField name="dropdown-lang" label="Idioma:" choices="Español,English" index="0" class="menu-dropdown"/>
                </engine:VisualElement>
                <engine:Button name="btn-settings-back" class="menu-btn menu-btn--back" style="margin-top: 30px;">
                    <engine:Label text="VOLVER" class="menu-btn__text"/>
                </engine:Button>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="screen-credits" class="screen-container" style="display: none;">
            <engine:VisualElement class="panel-container">
                <engine:Label text="CRÉDITOS" class="title-text"/>
                <engine:Label text="Desarrollado por Gabriel" class="credits-text"/>
                <engine:Label text="Motor: Unity" class="credits-text"/>
                <engine:Label text="Red: Mirror" class="credits-text"/>
                <engine:Button name="btn-credits-back" class="menu-btn menu-btn--back" style="margin-top: 30px;">
                    <engine:Label text="VOLVER" class="menu-btn__text"/>
                </engine:Button>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="screen-auth" class="screen-container" style="display: none;">
            <engine:VisualElement name="panel-profile-view" class="panel-container profile-panel" style="display: none;">
                <engine:Label text="MI PERFIL" class="title-text"/>
                <engine:VisualElement class="profile-card-header">
                    <engine:VisualElement class="profile-avatar--large">
                        <engine:Label text="🂡" class="profile-avatar__icon--large"/>
                    </engine:VisualElement>
                    <engine:VisualElement class="profile-card-details">
                        <engine:Label name="lbl-card-username" text="Gaucho" class="profile-card-username"/>
                        <engine:Label name="lbl-card-email" text="usuario@trucodefinitivo.app" class="profile-card-email"/>
                        <engine:Label name="lbl-card-badge" text="EN LÍNEA (NUBE)" class="profile-status-badge profile-status--cloud" style="align-self: flex-start;"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement class="stats-grid">
                    <engine:VisualElement class="stat-box">
                        <engine:Label text="NIVEL &amp; XP" class="stat-box__title"/>
                        <engine:Label name="lbl-stat-level" text="NV. 1 (0 / 100)" class="stat-box__value"/>
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-box">
                        <engine:Label text="FICHAS TOTALES" class="stat-box__title"/>
                        <engine:Label name="lbl-stat-coins" text="🪙 1.000" class="stat-box__value stat-box__value--gold"/>
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-box">
                        <engine:Label text="PARTIDAS GANADAS" class="stat-box__title"/>
                        <engine:Label name="lbl-stat-wins" text="0" class="stat-box__value stat-box__value--green"/>
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-box">
                        <engine:Label text="PARTIDAS PERDIDAS" class="stat-box__title"/>
                        <engine:Label name="lbl-stat-losses" text="0" class="stat-box__value"/>
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-box">
                        <engine:Label text="PORCENTAJE VICTORIA" class="stat-box__title"/>
                        <engine:Label name="lbl-stat-winrate" text="0.0%" class="stat-box__value"/>
                    </engine:VisualElement>
                    <engine:VisualElement class="stat-box">
                        <engine:Label text="MEJOR ENVIDO" class="stat-box__title"/>
                        <engine:Label name="lbl-stat-envido" text="0 pts" class="stat-box__value stat-box__value--gold"/>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:Button name="btn-profile-logout" class="menu-btn menu-btn--danger">
                    <engine:Label text="CERRAR SESIÓN" class="menu-btn__text"/>
                </engine:Button>
                <engine:Button name="btn-profile-back" class="menu-btn menu-btn--back" style="margin-top: 15px;">
                    <engine:Label text="VOLVER" class="menu-btn__text"/>
                </engine:Button>
            </engine:VisualElement>
            <engine:VisualElement name="panel-login-view" class="panel-container auth-panel">
                <engine:Label text="CUENTA Y NUBE" class="title-text"/>
                <engine:Label text="Guardá tus fichas, nivel y victorias en la nube o jugá como invitado local." class="auth-subtitle"/>
                <engine:VisualElement class="auth-tabs">
                    <engine:Button name="btn-tab-login" class="auth-tab-btn auth-tab-btn--active">
                        <engine:Label text="INICIAR SESIÓN" class="auth-tab-btn__text"/>
                    </engine:Button>
                    <engine:Button name="btn-tab-register" class="auth-tab-btn">
                        <engine:Label text="REGISTRARSE" class="auth-tab-btn__text"/>
                    </engine:Button>
                </engine:VisualElement>
                <engine:Label name="lbl-auth-status" text="" class="status-text" style="display: none;"/>
                <engine:VisualElement class="input-group">
                    <engine:Label text="Usuario o Correo:" class="input-label"/>
                    <engine:TextField name="input-auth-user" class="menu-input"/>
                </engine:VisualElement>
                <engine:VisualElement name="group-auth-displayname" class="input-group" style="display: none;">
                    <engine:Label text="Tu Apodo / Nombre en Juego:" class="input-label"/>
                    <engine:TextField name="input-auth-displayname" class="menu-input"/>
                </engine:VisualElement>
                <engine:VisualElement class="input-group">
                    <engine:Label text="Contraseña:" class="input-label"/>
                    <engine:TextField name="input-auth-pass" password="true" class="menu-input"/>
                </engine:VisualElement>
                <engine:VisualElement name="group-auth-remember" class="auth-remember-row">
                    <engine:Toggle name="toggle-auth-remember" text="Recordar mi sesión en este dispositivo" value="true" class="auth-remember-toggle"/>
                </engine:VisualElement>
                <engine:Button name="btn-auth-submit" class="menu-btn menu-btn--primary">
                    <engine:Label name="lbl-auth-submit" text="INICIAR SESIÓN" class="menu-btn__text"/>
                </engine:Button>
                <engine:VisualElement class="divider"/>
                <engine:Button name="btn-auth-guest" class="menu-btn menu-btn--secondary">
                    <engine:Label text="CONTINUAR COMO INVITADO" class="menu-btn__text"/>
                </engine:Button>
                <engine:Button name="btn-auth-back" class="menu-btn menu-btn--back" style="margin-top: 15px;">
                    <engine:Label text="VOLVER" class="menu-btn__text"/>
                </engine:Button>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Label name="lbl-game-version" text="v1.0.1" class="version-label" picking-mode="Ignore"/>
    </engine:VisualElement>
</engine:UXML>
