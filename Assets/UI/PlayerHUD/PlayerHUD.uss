/* =========================================================
   TRUCO DEFINITIVO - PLAYER HUD STYLES
   Game Aesthetic: Bold, Tactile, Minimalist & Cohesive
   ========================================================= */

/* --- ROOT HUD CONTAINER --- */
.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 0;
    -unity-font: url("project://database/Assets/Art/Fonts/Rubik.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rubik.ttf");
}

/* =========================================================
   TOP BAR (HEROIC SCOREBOARD PLAQUE & UTILITY BUTTONS)
   ========================================================= */
.hud-top-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

/* --- TANTEADOR DE TRUCO (Central Scoreboard Plaque) --- */
.central-banner {
    background-color: rgba(14, 18, 26, 0.96);
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    padding: 10px 24px 12px 24px;
    border-top-width: 0;
    border-bottom-width: 4.5px;
    border-bottom-color: rgba(0, 0, 0, 0.75);
    border-left-width: 1.5px;
    border-left-color: rgba(232, 211, 158, 0.35);
    border-right-width: 1.5px;
    border-right-color: rgba(232, 211, 158, 0.35);
    align-items: center;
    min-width: 280px;
    width: auto;
    max-width: 480px;
}

.hud-team__text {
    color: #BAC7D5;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1.5px;
    margin-bottom: 2px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
    max-width: 440px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.central-banner .hud-score__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    color: #FFFFFF;
    font-size: 42px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.7);
    margin-top: -2px;
    margin-bottom: 2px;
}

/* --- TURN INDICATOR BANNER --- */
.hud-turn-indicator {
    margin-top: 8px;
    align-items: center;
}

.hud-turn__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    color: #FFF1C5;
    font-size: 15px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    background-color: rgba(232, 211, 158, 0.2);
    border-radius: 12px;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(140, 95, 17, 0.9);
    padding: 5px 22px;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.8);
}

/* --- TRICKS DOTS (BAZAS PIPS / GEMSTONES) --- */
.tricks-dots-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
    width: 100%;
}

.team-dots {
    flex-direction: row;
    align-items: center;
    margin: 0 4px;
}

.trick-dot {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    max-width: 14px;
    max-height: 14px;
    flex-shrink: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.65);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.22);
    margin: 0 4px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.trick-dot.filled {
    background-color: #FFC83B;
    border-color: #FFF6C4;
    scale: 1.25;
}

.dots-separator {
    width: 16px;
}

/* --- TOP RIGHT CORNER HUD BUTTONS (Tactile Squircle Plaques) --- */
.hud-top-right-bar {
    position: absolute;
    top: 14px;
    right: 18px;
    flex-direction: row;
    align-items: center;
}

.hud-btn-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    margin-left: 8px;
    border-radius: 10px;
    justify-content: center;
    align-items: center;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: #0E151F;
    background-color: #1F2C3D;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.hud-btn-icon:hover {
    background-color: #2B3D54;
}

.hud-btn-icon:active {
    translate: 0 2px;
    border-bottom-width: 2px;
}

.hud-btn-icon__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 18px;
    color: #F0F4F8;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.7);
}

/* =========================================================
   EVENT OVERLAY (ANNOUNCEMENT / CANTO HERO BANNER)
   ========================================================= */
.hud-event-overlay {
    position: absolute;
    top: 25%;
    left: 5%;
    right: 5%;
    align-items: center;
    justify-content: center;
}

#notification-label {
    display: flex;
    opacity: 0;
    scale: 0.8;
    background-color: rgba(14, 18, 26, 0.95);
    color: #FFDF80;
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 26px;
    letter-spacing: 1.5px;
    padding: 12px 32px;
    border-radius: 14px;
    border-top-width: 1px;
    border-top-color: rgba(232, 211, 158, 0.4);
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 4px;
    border-bottom-color: #8C5F11;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 80%;
    text-shadow: 0 2px 0 #0A0F17;
    transition-property: opacity, scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

#notification-label.visible {
    opacity: 1;
    scale: 1;
}

/* =========================================================
   BOTTOM AREA (CANTOS: TRUCO, ENVIDO, FLOR, A LEY)
   ========================================================= */
.hud-bottom-area {
    position: absolute;
    bottom: 24px;
    left: 24px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
}

#hud-action-bar {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
    width: 370px;
    max-width: 370px;
}

#hud-action-bar .hud-btn {
    width: 172px;
    height: 58px;
    min-height: 58px;
    margin: 6px;
}

/* =========================================================
   RIGHT AREA (RESPONSES: QUIERO, NO QUIERO, RE-ENVIDAR)
   ========================================================= */
.hud-right-area {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 24px;
    justify-content: center;
    align-items: flex-end;
}

#hud-response-bar {
    flex-direction: column;
    align-items: center;
    background-color: rgba(14, 18, 26, 0.96);
    border-radius: 16px;
    border-top-width: 1.5px;
    border-top-color: rgba(232, 211, 158, 0.4);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.7);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    padding: 18px 20px;
    width: 264px;
}

.hud-response-title__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    color: #E8D39E;
    font-size: 16px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 14px;
    width: 100%;
    white-space: normal;
    text-shadow: 0 2px 0 #0A0F17;
}

/* =========================================================
   SLIDER (STONES / ENVIDO POINTS)
   ========================================================= */
.hud-slider-container {
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 8px 12px;
    border-radius: 10px;
    margin: 8px 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    width: 100%;
}

.hud-slider__label {
    color: #E8D39E;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.hud-slider {
    width: 100%;
    max-width: 190px;
}

.hud-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.15);
    height: 6px;
    border-radius: 3px;
    border-width: 0;
    margin-top: -3px;
}

.hud-slider .unity-base-slider__dragger {
    background-color: #FFD56B;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #FFF3C4;
    margin-top: -10px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.hud-slider .unity-base-slider__dragger:hover {
    scale: 1.25;
}

/* =========================================================
   HUD BUTTONS (FLAT DESIGN WITH SOLID DROP SHADOW)
   ========================================================= */
.hud-btn {
    border-radius: 12px;
    height: 52px;
    min-height: 52px;
    padding: 0 18px;
    align-items: center;
    justify-content: center;
    border-top-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 5px;
    border-bottom-color: #111A26;
    background-color: #223348;
    transition-property: background-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.hud-btn:hover {
    background-color: #2D425C;
}

.hud-btn:active {
    translate: 0 3px;
    border-bottom-width: 2px;
}

.hud-btn__text {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 18px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    color: #FFFFFF;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.55);
    white-space: normal;
}

.hud-btn__text--small {
    font-size: 13px;
    letter-spacing: 0.5px;
    -unity-text-align: middle-center;
}

/* Color Variants */
.hud-btn--accept {
    background-color: #27AE60;
    border-bottom-color: #145A32;
    width: 100%;
    height: 54px;
    min-height: 54px;
}

.hud-btn--accept:hover {
    background-color: #2ECC71;
}

.hud-btn--accept .hud-btn__text {
    text-shadow: 0 2px 0 #0E3E22;
}

.hud-btn--decline {
    background-color: #C0392B;
    border-bottom-color: #641E16;
    width: 100%;
    height: 48px;
    min-height: 48px;
    margin-top: 8px;
}

.hud-btn--decline:hover {
    background-color: #D94534;
}

.hud-btn--decline .hud-btn__text {
    font-size: 18px;
    color: #FFD5D5;
    text-shadow: 0 2px 0 #4A130C;
}

.hud-btn--more {
    background-color: #D4AC0D;
    border-bottom-color: #7D6608;
    width: 100%;
    height: 48px;
    min-height: 48px;
    margin-top: 8px;
}

.hud-btn--more:hover {
    background-color: #F1C40F;
}

.hud-btn--more .hud-btn__text {
    font-size: 18px;
    color: #261D02;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
}

/* Action Variants (Cantos) */
.hud-btn--truco {
    background-color: #C0392B;
    border-bottom-color: #641E16;
}

.hud-btn--truco:hover {
    background-color: #D94534;
}

.hud-btn--truco .hud-btn__text {
    text-shadow: 0 2px 0 #4A130C;
}

.hud-btn--envido {
    background-color: #E67E22;
    border-bottom-color: #87460D;
}

.hud-btn--envido:hover {
    background-color: #F39C12;
}

.hud-btn--envido .hud-btn__text {
    text-shadow: 0 2px 0 #5A2E08;
}

.hud-btn--flor {
    background-color: #8E44AD;
    border-bottom-color: #4A235A;
}

.hud-btn--flor:hover {
    background-color: #9B59B6;
}

.hud-btn--flor .hud-btn__text {
    text-shadow: 0 2px 0 #32173E;
}

.hud-btn--aley {
    background-color: #2980B9;
    border-bottom-color: #154360;
}

.hud-btn--aley:hover {
    background-color: #3498DB;
}

.hud-btn--aley .hud-btn__text {
    text-shadow: 0 2px 0 #0E2C3F;
}

/* =========================================================
   CARD ACTION MENU (JUGAR / QUEMAR)
   ========================================================= */
.card-action-menu {
    position: absolute;
    bottom: 22%;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.card-action-menu .hud-btn {
    height: 50px;
    min-height: 50px;
    padding: 0 28px;
    margin: 0 8px;
    width: auto;
    min-width: 140px;
}

.card-action-menu .hud-btn__text {
    font-size: 18px;
    letter-spacing: 2px;
}

/* =========================================================
   ENVIDO STAKE INDICATOR (PIEDRAS EN JUEGO)
   ========================================================= */
.envido-stake-chip {
    -unity-font: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/LilitaOne-Regular.ttf");
    font-size: 13px;
    color: #FFDF80;
    background-color: rgba(18, 24, 34, 0.95);
    border-top-width: 1px;
    border-top-color: rgba(232, 211, 158, 0.35);
    border-left-width: 0;
    border-right-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: #8C5F11;
    border-radius: 8px;
    padding: 3px 14px;
    margin-top: 6px;
    margin-bottom: 2px;
    letter-spacing: 1.5px;
    text-shadow: 0 1px 0 #0A0F17;
    -unity-text-align: middle-center;
    align-self: center;
}

/* =========================================================
   MODALS (ESCALERA, PAUSE, MATCH END, QUIT CONFIRM)
   ========================================================= */
.hierarchy-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 8, 12, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.hierarchy-modal-overlay.visible {
    display: flex;
}

.hierarchy-panel {
    background-color: rgba(15, 19, 27, 0.97);
    border-radius: 18px;
    border-top-width: 2px;
    border-top-color: rgba(232, 211, 158, 0.45);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.75);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    padding: 32px 38px;
    width: 480px;
    max-width: 90%;
    align-items: center;
}

.modal-panel--compact {
    width: 420px;
    padding: 32px 36px;
}

.hierarchy-title {
    -unity-font: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rye-Regular.ttf");
    color: #E8D39E;
    font-size: 26px;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 22px;
    white-space: normal;
    text-shadow: 0 2px 0 #070A0F;
}

.hierarchy-scroll {
    width: 100%;
    height: 340px;
    margin-bottom: 22px;
    background-color: rgba(8, 11, 16, 0.6);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 8px 12px;
}

.hierarchy-item {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 8px 12px;
    margin-bottom: 4px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.03);
}

.hierarchy-item--high {
    color: #FFD56B;
    background-color: rgba(255, 213, 107, 0.08);
}

.hierarchy-item--mid {
    color: #FFFFFF;
}

.hierarchy-item--low {
    color: #A0B0C2;
}

.hierarchy-item--lowest {
    color: #6E7D8F;
}

.modal-vertical-btns {
    width: 100%;
    align-items: stretch;
}

.modal-btn-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 12px;
}

.modal-btn {
    width: 100%;
    height: 52px;
    min-height: 52px;
    margin: 6px 0;
}

.modal-btn-row > .modal-btn {
    width: 48%;
    margin: 0;
}

.modal-close-btn {
    width: 60%;
    height: 48px;
    min-height: 48px;
}

.match-end-subtitle {
    color: #BAC7D5;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    letter-spacing: 1px;
    white-space: normal;
}
