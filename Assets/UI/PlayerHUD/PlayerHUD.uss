/* =========================================================
   TRUCO DEFINITIVO - PLAYER HUD STYLES
   Game Aesthetic: Bold, Tactile, Minimalist & Cohesive
   ========================================================= */

/* --- ROOT HUD CONTAINER --- */
.hud-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
    padding: 0;
}

/* =========================================================
   TOP BAR (HEROIC SCOREBOARD PLAQUE & UTILITY BUTTONS)
   ========================================================= */
.hud-top-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

/* --- TANTEADOR DE TRUCO (Central Scoreboard Plaque) --- */
.central-banner {
    background-color: rgba(14, 18, 26, 0.96);
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    padding: 10px 28px 14px 28px;
    border-top-width: 0;
    border-bottom-width: 4.5px;
    border-bottom-color: rgba(0, 0, 0, 0.75);
    border-left-width: 1.5px;
    border-left-color: rgba(232, 211, 158, 0.35);
    border-right-width: 1.5px;
    border-right-color: rgba(232, 211, 158, 0.35);
    align-items: center;
    min-width: 320px;
    width: auto;
    max-width: 90%;
}

.hud-team__text {
    color: #BAC7D5;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 2px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
}

.central-banner .hud-score__text {
    color: #FFFFFF;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    text-shadow: 0 3px 12px rgba(0, 0, 0, 0.95);
    margin-top: -2px;
    margin-bottom: 2px;
}

/* --- TURN INDICATOR BANNER --- */
.hud-turn-indicator {
    margin-top: 8px;
    align-items: center;
}

.hud-turn__text {
    color: #FFF1C5;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2.5px;
    background-color: rgba(232, 211, 158, 0.2);
    border-radius: 12px;
    border-top-width: 1px;
    border-top-color: #FFF4D1;
    border-bottom-width: 3px;
    border-bottom-color: rgba(160, 125, 55, 0.8);
    border-left-width: 1px;
    border-left-color: #E8D39E;
    border-right-width: 1px;
    border-right-color: #E8D39E;
    padding: 5px 22px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}

/* --- TRICKS DOTS (BAZAS PIPS / GEMSTONES) --- */
.tricks-dots-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
    width: 100%;
}

.team-dots {
    flex-direction: row;
    align-items: center;
    margin: 0 4px;
}

.trick-dot {
    width: 14px;
    height: 14px;
    min-width: 14px;
    min-height: 14px;
    max-width: 14px;
    max-height: 14px;
    flex-shrink: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.65);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.22);
    margin: 0 4px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.trick-dot.filled {
    background-color: #FFC83B;
    border-color: #FFF6C4;
    scale: 1.25;
}

.dots-separator {
    width: 16px;
}

/* --- TOP RIGHT CORNER HUD BUTTONS (Tactile Squircle Plaques) --- */
.hud-btn-icon {
    position: absolute;
    top: 16px;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    justify-content: center;
    align-items: center;
    border-top-width: 1.5px;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-width: 4px;
    border-bottom-color: rgba(0, 0, 0, 0.65);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(22, 28, 38, 0.94);
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hud-btn-pause  { right: 18px; }
.hud-btn-info   { right: 74px; }
.hud-btn-camera { right: 130px; }
.hud-btn-look   { right: 186px; }

.hud-btn-icon:hover {
    scale: 1.05;
    translate: 0 -2px;
    background-color: rgba(36, 46, 62, 0.98);
    border-top-color: rgba(255, 255, 255, 0.6);
}

.hud-btn-icon:active {
    scale: 0.95;
    translate: 0 3px;
    border-bottom-width: 1.5px;
}

.hud-btn-icon__text {
    font-size: 18px;
    -unity-font-style: bold;
    color: #F0F4F8;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
}

/* =========================================================
   EVENT OVERLAY (ANNOUNCEMENT / CANTO HERO BANNER)
   ========================================================= */
.hud-event-overlay {
    position: absolute;
    top: 32%;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
}

#notification-label {
    display: flex;
    opacity: 0;
    scale: 0.8;
    background-color: rgba(14, 18, 26, 0.97);
    color: #FFDF80;
    font-size: 46px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    padding: 18px 52px;
    border-radius: 16px;
    border-top-width: 2px;
    border-top-color: #E8D39E;
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.8);
    border-left-width: 1.5px;
    border-left-color: rgba(232, 211, 158, 0.4);
    border-right-width: 1.5px;
    border-right-color: rgba(232, 211, 158, 0.4);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.95);
    transition-property: opacity, scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

#notification-label.visible {
    opacity: 1;
    scale: 1;
}

/* =========================================================
   BOTTOM AREA (CANTOS: TRUCO, ENVIDO, FLOR, A LEY)
   ========================================================= */
.hud-bottom-area {
    position: absolute;
    bottom: 24px;
    left: 24px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
}

#hud-action-bar {
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
    width: 370px;
    max-width: 370px;
}

#hud-action-bar .hud-btn {
    width: 172px;
    height: 56px;
    min-height: 56px;
    margin: 6px;
}

/* =========================================================
   RIGHT AREA (RESPONSES: QUIERO, NO QUIERO, RE-ENVIDAR)
   ========================================================= */
.hud-right-area {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 28px;
    justify-content: center;
    align-items: flex-end;
}

#hud-response-bar {
    flex-direction: column;
    align-items: center;
    background-color: rgba(14, 18, 26, 0.96);
    border-radius: 16px;
    border-top-width: 1.5px;
    border-top-color: rgba(232, 211, 158, 0.4);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.7);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    padding: 22px 24px;
    width: 250px;
}

.hud-response-title__text {
    color: #E8D39E;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 16px;
    width: 100%;
    white-space: normal;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

/* =========================================================
   SLIDER (STONES / ENVIDO POINTS)
   ========================================================= */
.hud-slider-container {
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
    padding: 10px 14px;
    border-radius: 10px;
    margin: 10px 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    width: 100%;
}

.hud-slider__label {
    color: #E8D39E;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
}

.hud-slider {
    width: 190px;
}

.hud-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.15);
    height: 6px;
    border-radius: 3px;
    border-width: 0;
    margin-top: -3px;
}

.hud-slider .unity-base-slider__dragger {
    background-color: #FFD56B;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: #FFF3C4;
    margin-top: -10px;
    transition-property: scale;
    transition-duration: 0.1s;
}

.hud-slider .unity-base-slider__dragger:hover {
    scale: 1.25;
}

/* =========================================================
   HUD BUTTONS (TACTILE 3D BEVEL & HIGH GAME IMPACT)
   ========================================================= */
.hud-btn {
    border-radius: 12px;
    height: 52px;
    min-height: 52px;
    padding: 0 18px;
    align-items: center;
    justify-content: center;
    border-top-width: 1.5px;
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-width: 4.5px;
    border-bottom-color: rgba(0, 0, 0, 0.65);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(28, 36, 48, 0.95);
    transition-property: scale, translate, background-color, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.hud-btn:hover {
    scale: 1.03;
    translate: 0 -2px;
    border-top-color: rgba(255, 255, 255, 0.6);
}

.hud-btn:active {
    scale: 0.98;
    translate: 0 4px;
    border-bottom-width: 1.5px;
}

.hud-btn__text {
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}

/* Color Variants */
.hud-btn--accept {
    background-color: #1E824C;
    border-top-color: rgba(130, 240, 160, 0.6);
    border-bottom-color: #0A3D20;
    width: 100%;
    height: 54px;
    min-height: 54px;
}

.hud-btn--accept:hover {
    background-color: #259E5D;
    border-top-color: rgba(170, 255, 190, 0.8);
}

.hud-btn--decline {
    background-color: #7A2424;
    border-top-color: rgba(255, 140, 140, 0.45);
    border-bottom-color: #380C0C;
    width: 100%;
    height: 48px;
    min-height: 48px;
    margin-top: 8px;
}

.hud-btn--decline:hover {
    background-color: #962E2E;
    border-top-color: rgba(255, 180, 180, 0.7);
}

.hud-btn--decline .hud-btn__text {
    font-size: 17px;
    color: #FFCCCC;
}

.hud-btn--more {
    background-color: #B57E1E;
    border-top-color: rgba(255, 220, 140, 0.6);
    border-bottom-color: #543605;
    width: 100%;
    height: 48px;
    min-height: 48px;
    margin-top: 8px;
}

.hud-btn--more:hover {
    background-color: #D19424;
    border-top-color: rgba(255, 240, 180, 0.8);
}

.hud-btn--more .hud-btn__text {
    font-size: 17px;
    color: #FFF6DD;
}

/* Action Variants (Cantos) */
.hud-btn--truco {
    background-color: #A92D2D;
    border-top-color: rgba(255, 160, 160, 0.6);
    border-bottom-color: #4A0D0D;
}

.hud-btn--truco:hover {
    background-color: #C73636;
    border-top-color: rgba(255, 200, 200, 0.8);
}

.hud-btn--envido {
    background-color: #C2821A;
    border-top-color: rgba(255, 220, 140, 0.6);
    border-bottom-color: #573705;
}

.hud-btn--envido:hover {
    background-color: #DB9522;
    border-top-color: rgba(255, 240, 180, 0.8);
}

.hud-btn--flor {
    background-color: #7B2CBF;
    border-top-color: rgba(220, 150, 255, 0.6);
    border-bottom-color: #370F59;
}

.hud-btn--flor:hover {
    background-color: #9239E0;
    border-top-color: rgba(240, 190, 255, 0.8);
}

.hud-btn--aley {
    background-color: #1E5AA8;
    border-top-color: rgba(140, 190, 255, 0.6);
    border-bottom-color: #0B254A;
}

.hud-btn--aley:hover {
    background-color: #2874D4;
    border-top-color: rgba(180, 220, 255, 0.8);
}

/* =========================================================
   CARD ACTION MENU (JUGAR / QUEMAR)
   ========================================================= */
.card-action-menu {
    position: absolute;
    bottom: 22%;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.card-action-menu .hud-btn {
    height: 50px;
    min-height: 50px;
    padding: 0 28px;
    margin: 0 8px;
    width: auto;
    min-width: 140px;
}

.card-action-menu .hud-btn__text {
    font-size: 18px;
    letter-spacing: 2px;
}

/* =========================================================
   ENVIDO STAKE INDICATOR (PIEDRAS EN JUEGO)
   ========================================================= */
.envido-stake-chip {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFDF80;
    background-color: rgba(14, 18, 26, 0.95);
    border-width: 1.5px;
    border-color: #E8D39E;
    border-bottom-width: 3.5px;
    border-bottom-color: rgba(0, 0, 0, 0.7);
    border-radius: 14px;
    padding: 8px 24px;
    letter-spacing: 2px;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.9);
}

/* =========================================================
   MODALS (ESCALERA, PAUSE, MATCH END, QUIT CONFIRM)
   ========================================================= */
.hierarchy-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 8, 12, 0.85);
    align-items: center;
    justify-content: center;
    display: none;
}

.hierarchy-modal-overlay.visible {
    display: flex;
}

.hierarchy-panel {
    background-color: rgba(15, 19, 27, 0.97);
    border-radius: 18px;
    border-top-width: 2px;
    border-top-color: rgba(232, 211, 158, 0.45);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0.75);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.1);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
    padding: 32px 38px;
    width: 480px;
    max-width: 90%;
    align-items: center;
}

.modal-panel--compact {
    width: 420px;
    padding: 32px 36px;
}

.hierarchy-title {
    color: #E8D39E;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    margin-bottom: 22px;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
}

.hierarchy-scroll {
    width: 100%;
    height: 340px;
    margin-bottom: 22px;
    background-color: rgba(8, 11, 16, 0.6);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 8px 12px;
}

.hierarchy-item {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 8px 12px;
    margin-bottom: 4px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.03);
}

.hierarchy-item--high {
    color: #FFD56B;
    background-color: rgba(255, 213, 107, 0.08);
}

.hierarchy-item--mid {
    color: #FFFFFF;
}

.hierarchy-item--low {
    color: #A0B0C2;
}

.hierarchy-item--lowest {
    color: #6E7D8F;
}

.modal-vertical-btns {
    width: 100%;
    align-items: stretch;
}

.modal-btn-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 12px;
}

.modal-btn {
    width: 100%;
    height: 52px;
    min-height: 52px;
    margin: 6px 0;
}

.modal-btn-row > .modal-btn {
    width: 48%;
    margin: 0;
}

.modal-close-btn {
    width: 60%;
    height: 48px;
    min-height: 48px;
}

.match-end-subtitle {
    color: #BAC7D5;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    letter-spacing: 1px;
}
